{
  "name": "stemwright",
  "version": "0.1.0",
  "private": true,
  "description": "A drill desk for inflectional paradigms",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@vitest/coverage-v8": "1.5.0",
    "eslint": "8.57.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "typescript-eslint": "7.7.1",
    "vitest": "1.5.0"
  }
}
