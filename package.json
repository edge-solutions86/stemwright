{
  "name": "stemwright",
  "version": "0.6.0",
  "private": true,
  "description": "A drill desk for inflectional paradigms",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/bin/serve.js",
    "cli": "tsx src/bin/stemwright.ts",
    "dev": "tsx watch src/bin/serve.ts",
    "verify": "node scripts/verify.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "docs": "node scripts/surface.mjs",
    "docs:check": "node scripts/surface.mjs check",
    "release:check": "node scripts/release.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.13.1",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vitest": "3.0.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stemwright": "dist/bin/stemwright.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ]
}
